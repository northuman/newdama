--- !u!114 &2045246078628113548
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5389118085223535656}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "-Recuerdo cuando mis padres, los marqueses de Villafranca del Bierzo,
    me informaron sobre su decisi\xF3n de encomendarme a la Orden de las Hermanas
    Pobres de Santa Clara. En un principio fui reticente pero acab\xE9 aceptando,
    siendo enviada al monasterio de las Descalzas Reales en Madrid. Son ya 10 a\xF1os
    vividos junto a mis hermanas y debo decir que no me arrepiento. Adem\xE1s de
    las labores religiosas, la biblioteca me proporciona conocimientos que jam\xE1s
    hubiera podido imaginar."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
